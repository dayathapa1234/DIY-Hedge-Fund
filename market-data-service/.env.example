SERVICE_NAME=market-data-service
ENVIRONMENT=local
VERSION=dev
COMMIT_SHA=unknown
BUILD_TIME=unknown
LOG_OUTPUT=both
LOG_FILE_PATH=/app/logs/market-data-service.log
ADDR=:8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s
PROVIDER_TIMEOUT=30s
DEPENDENCY_RETRY=30s
PROVIDER_PRIORITY=stooq,yfinance,openbb
STOOQ_BASE_URL=https://stooq.com/q/d/l/
YFINANCE_PYTHON=python3
YFINANCE_SCRIPT=/app/scripts/yfinance_fetch.py
OPENBB_BASE_URL=
POSTGRES_USER=market
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=market_data
DATABASE_URL=postgres://market:change_me_postgres_password@postgres:5432/market_data?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0
CACHE_TTL=5m
FEED_ENABLED=true
FEED_INTERVAL=12h
RATE_LIMIT_PER_MINUTE=120
